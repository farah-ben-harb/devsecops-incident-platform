APP_NAME=DevSecOps Incident Platform
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_PAGE_SIZE=20
# Local-only placeholder. Set a unique random value in deployments; production rejects this prefix.
INCIDENT_API_TOKEN=local-development-token-change-before-deploy
POSTGRES_DB=incident_db
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=change_me
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://incident_user:change_me@localhost:5432/incident_db

